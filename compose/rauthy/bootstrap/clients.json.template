[
    {
        "id": "synapse",
        "name": "Matrix Synapse",
        "confidential": true,
        "secret": "${SYNAPSE_OIDC_CLIENT_SECRET}",
        "redirect_uris": [
            "https://synapse.carp.rodeo/_synapse/client/oidc/callback"
        ],
        "post_logout_redirect_uris": [],
        "allowed_origins": [
            "https://synapse.carp.rodeo"
        ],
        "enabled": true,
        "flows_enabled": [
            "authorization_code",
            "refresh_token"
        ],
        "access_token_alg": "EdDSA",
        "id_token_alg": "EdDSA",
        "access_token_lifetime": 1800,
        "scopes": [
            "openid",
            "profile",
            "email",
            "groups",
            "carp_profile"
        ],
        "default_scopes": [
            "openid",
            "profile",
            "email"
        ],
        "challenges": [
            "S256"
        ],
        "force_mfa": false
    }
]
