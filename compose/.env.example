# copy to .env and fill in real values
# NEVER commit .env — it contains secrets

# --- postgres ---
POSTGRES_PASSWORD=change-me-generate-a-strong-password

# --- rauthy encryption keys ---
# generate: openssl rand -base64 32
# format: key_id/base64_key (key_id is alphanumeric, 2-20 chars)
RAUTHY_ENC_KEYS=mykey01/CHANGE_ME_BASE64_32_BYTES
RAUTHY_ENC_KEY_ACTIVE=mykey01

# --- rauthy Hiqlite secrets ---
# generate: openssl rand -hex 16
RAUTHY_HQL_SECRET_RAFT=change-me-at-least-16-chars
RAUTHY_HQL_SECRET_API=change-me-at-least-16-chars

# --- rauthy bootstrap ---
# generated randomly by `make gen-env`. used for initial admin login only.
# after first login + passkey enrollment, clear this value and restart rauthy.
RAUTHY_BOOTSTRAP_PASSWORD=

# --- admin email ---
ADMIN_EMAIL=admin@carp.rodeo

# --- SMTP (Resend) ---
SMTP_URL=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxx
SMTP_FROM=carp.rodeo <auth@carp.rodeo>

# --- Synapse OIDC client ---
# generate: openssl rand -base64 32
# MUST match the secret in bootstrap/clients.json
SYNAPSE_OIDC_CLIENT_SECRET=change-me-generate-a-secret

# --- OVH S3 (Synapse media + Rauthy backups + user pictures) ---
# create buckets in OVH Cloud dashboard first
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_ENDPOINT=https://s3.us-east-va.perf.cloud.ovh.us
S3_REGION=us-east-1
S3_MEDIA_BUCKET=carp-rodeo-synapse-media
S3_BACKUP_BUCKET=carp-rodeo-rauthy-backups
S3_PICTURES_BUCKET=carp-rodeo-rauthy-pictures
